{
  "name": "ggs",
  "version": "0.24.0",
  "private": true,
  "description": "GGS - a browser-based, pattern-and-playlist DAW (Node.js + React) with an MCP server so Claude can make beats with you.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:local": "NO_LOGIN=1 npm run dev",
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "mcp": "node server/src/mcp/stdio.js",
    "test": "npm test -w packages/core && npm test -w packages/synth-dsp && npm test -w packages/chord-grid && npm test -w server && npm test -w client",
    "docs:av": "node scripts/av-bible.mjs",
    "film": "node tools/film/kaleidoscope.mjs",
    "film:record": "node tools/film/record.mjs",
    "docs:mcp": "cd server && node ../scripts/gen-mcp-docs.mjs",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build && SCREENSHOTS=1 playwright test e2e/screenshots.spec.js",
    "lint": "eslint .",
    "reset-password": "node server/src/cli/reset-password.js",
    "plugin:pack": "node scripts/pack-plugin.mjs",
    "skills:pack": "node scripts/pack-skills.mjs",
    "bench:synth": "node packages/synth-dsp/scripts/bench.mjs",
    "fixture:av": "node scripts/av-fixture.mjs",
    "av:replay": "node scripts/av-replay.mjs",
    "song:setup": "bash tools/song-analyzer/setup.sh",
    "song:study": "node tools/song-analyzer/to-daw.mjs",
    "song:audition": "node tools/song-analyzer/audition.mjs",
    "song:bundle": "node tools/song-analyzer/bundle.mjs",
    "song:library": "node tools/song-analyzer/library.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0"
  }
}
